# Токен бота из @BotFather — НЕ коммить реальное значение, задавай в переменных окружения хостинга
BOT_TOKEN=your-telegram-bot-token-here
# URL развёрнутого Mini App
MINI_APP_URL=https://fitroom-mini-app-main.vercel.app/
# Строка подключения к Postgres (Neon/Supabase). Если пусто — локально бот пишет в bookings.json
# На Vercel (webhook) DATABASE_URL обязателен — иначе не сохранятся ни брони, ни сессии диалога.
DATABASE_URL=
# Секрет вебхука: любая случайная строка. Должен совпадать в переменных Vercel и при установке вебхука.
WEBHOOK_SECRET=
# ID чата владельца для уведомлений о новых/отменённых бронях. Узнать свой id можно у @userinfobot. Если пусто — уведомления выключены.
ADMIN_CHAT_ID=
