# Copy to .env and adjust before deploying.

# Port the site is served on (host side).
PORT=8000

# --- Database ---
# Default is SQLite on a docker volume (no extra services needed):
DATABASE_URL=sqlite:////data/helpdesk.db
# To use PostgreSQL instead, uncomment the db service in docker-compose.yml and set:
# DATABASE_URL=postgresql+psycopg2://helpdesk:helpdesk@db:5432/helpdesk

# --- Security ---
# CHANGE THIS to a long random string in production.
SECRET_KEY=change-me-in-production-please

# --- Initial administrator (created on first boot only) ---
ADMIN_EMAIL=admin@helpdesk.local
ADMIN_PASSWORD=admin12345
