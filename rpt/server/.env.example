# ---- RPT server configuration ----

# Порт веб-панели администратора (НЕ 80 и НЕ 443, любой свободный).
RPT_WEB_PORT=8443

# Публичный порт SSH-хаба, к которому подключаются роботы обратными туннелями.
RPT_HUB_PORT=2222

# Внешний адрес/IP этого сервера — его роботы используют для подключения к хабу.
# Заполняется автоматически скриптом server-install.sh.
RPT_HUB_PUBLIC_HOST=203.0.113.10

# Пароль администратора веб-панели.
RPT_ADMIN_PASSWORD=changeme
